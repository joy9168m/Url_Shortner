<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: sans-serif;
    }

    body {
      background-image: url('/green.png');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      min-height: 100vh;
      color: #ffffff;
      display: flex;
      justify-content: center;
      padding: 3rem 1rem;
    }

    .card {
      background: rgba(18, 18, 18, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 2rem;
      width: 100%;
      max-width: 800px;
      height: fit-content;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
    }

    h1 {
      margin-bottom: 1.5rem;
    }

    .form-box {
      display: flex;
      gap: 10px;
      margin-bottom: 1.5rem;
    }

    input[type="text"] {
      flex: 1;
      padding: 0.6rem 1rem;
      border-radius: 5px;
      border: 1px solid #444;
      background: #111;
      color: #fff;
    }
    input[type="password"] {
      flex: 1;
      padding: 0.6rem 1rem;
      border-radius: 5px;
      border: 1px solid #444;
      background: #111;
      color: #fff;
    }
    input[type="email"] {
      flex: 1;
      padding: 0.6rem 1rem;
      border-radius: 5px;
      border: 1px solid #444;
      background: #111;
      color: #fff;
    }



    button {
      padding: 0.6rem 1.2rem;
      border: none;
      border-radius: 5px;
      background: #22c55e;
      color: #000;
      font-weight: bold;
      cursor: pointer;
    }

    a {
      color: #38bdf8;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    ul {
      list-style: none;
    }

    li {
      padding: 0.8rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      justify-content: space-between;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <h1>Sign up</h1> 
  <p>
  <div>
   <form method="POST" action="/signup" class="form-box" > 
      <label>Full Name: </label>
      <input type="text" name="name" placeholder="John Doe" required>
      <label>Email: </label>
      <input type="email" name="email" placeholder="www.example.com" required>
      <label>Password: </label>
      <input type="password" name="password" placeholder="password" required>
      <button type="submit">Submit</button>
   </form> 
  </div>
  </p>
</body>
</html>
